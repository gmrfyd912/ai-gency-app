{
  "expo": {
    "name": "ai-gency-app",
    "slug": "ai-gency-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/my-icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/my-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/my-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.gmrfyd912.aigencyapp"
    },
    "web": {
      "favicon": "./assets/my-icon.png"
    },
    "extra": {
      "eas": {
        "projectId": "2bbb6d58-8a02-4cdd-9791-17a16e33157f"
      }
    },
    "plugins": [
      "expo-font"
    ]
  }
}
